# FlowMind AI function secrets. Names only. Never commit real values.
# Set these as Base44 function secrets, never in frontend code.

BASE44_APP_ID=

# Execution engine
WORKFLOW_EXEC_LEASE_SECONDS=300
WORKFLOW_EXEC_BUDGET_MS=240000
WORKFLOW_MAX_NODES_PER_RUN=200
WORKFLOW_MAX_PARALLEL=3

# Webhooks
WEBHOOK_SIGNING_SECRET=
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# AI provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_DEFAULT_MODEL=

# Credential storage
CREDENTIAL_ENCRYPTION_KEY=

# SSRF guard for the HTTP node. Must stay false in production.
SSRF_ALLOW_PRIVATE=false
